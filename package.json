{
  "name": "@genesismesh/plugin-scaffolder-backend-module-genesismesh",
  "version": "0.1.0",
  "private": true,
  "description": "Genesis Mesh governed actions for the Backstage Scaffolder, with an isolated local integration lab",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "examples",
    "config.d.ts"
  ],
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "scaffolder",
    "pluginPackage": "@backstage/plugin-scaffolder-backend"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "tsx dev/backend.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/integration.ts",
    "local:setup": "node scripts/setup.mjs",
    "local:start": "tsx scripts/local.ts"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "1.11.0",
    "@backstage/config": "1.3.6",
    "@backstage/plugin-scaffolder-node": "0.13.8",
    "genesis-mesh-sdk": "1.8.1"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "0.18.1",
    "@backstage/plugin-catalog-backend": "4.0.2",
    "@backstage/plugin-catalog-backend-module-scaffolder-entity-model": "0.2.25",
    "@backstage/plugin-scaffolder-backend": "4.2.1",
    "@types/express": "4.17.25",
    "@types/node": "^24.0.0",
    "better-sqlite3": "12.11.1",
    "express": "4.22.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "infinispan": {
      "urllib": "4.9.1"
    }
  },
  "configSchema": "config.d.ts"
}
